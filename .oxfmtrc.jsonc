{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "printWidth": 100,
  "ignorePatterns": ["public/mockServiceWorker.js"],
  "sortImports": {
    "internalPattern": ["@/", "app/", "mocks/", "modules/", "routes/", "shared/", "widgets/"],
    "customGroups": [
      {
        "groupName": "react",
        "elementNamePattern": ["react", "react-dom", "react/**", "react-dom/**"],
      },
    ],
    "groups": [
      "react",
      "builtin",
      "external",
      "internal",
      ["parent", "sibling", "index"],
      "style",
      "unknown",
    ],
  },
}
