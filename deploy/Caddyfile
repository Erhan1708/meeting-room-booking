# Статическая раздача SPA. API нет: запросы /api/* перехватывает MSW в браузере.

:80 {
    encode zstd gzip
    root * /srv/dist

    # Длинный кэш для захешированных ассетов Vite
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # index.html и Service Worker MSW — без кэша, чтобы новые версии подхватывались сразу
    @nocache path /index.html /mockServiceWorker.js
    header @nocache Cache-Control "no-cache, no-store, must-revalidate"

    # SPA fallback: если файла нет — отдаём index.html, React Router разберётся
    try_files {path} /index.html
    file_server

    log {
        output stdout
        format console
    }
}
